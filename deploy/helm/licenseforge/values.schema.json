{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "auditVerify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalMinutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "fullIntervalHours": {"type": "integer", "minimum": 1, "maximum": 8760}
      }
    },
    "trustedProxies": {"type": "string"},
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "issuer": {"type": "string"},
        "clientID": {"type": "string"},
        "redirectURL": {"type": "string"},
        "clientSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          },
          "if": {"required": ["secretName"], "properties": {"secretName": {"minLength": 1}}},
          "then": {"required": ["key"]}
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "to": {"type": "array", "items": {
              "type": "object", "minProperties": 1, "additionalProperties": false,
              "properties": {
                "ipBlock": {"type": "object"},
                "namespaceSelector": {"type": "object"},
                "podSelector": {"type": "object"}
              }
            }}
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "syslog": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host": {"type": "string", "pattern": "^[^\\s/]*$"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "serverName": {"type": "string"},
                "caSecret": {"type": "string"},
                "clientSecret": {"type": "string"},
                "sdID": {"type": "string"},
                "to": {"type": "array", "items": {
                  "type": "object", "minProperties": 1, "additionalProperties": false,
                  "properties": {
                    "ipBlock": {"type": "object"},
                    "namespaceSelector": {"type": "object"},
                    "podSelector": {"type": "object"}
                  }
                }}
              },
              "if": {"required": ["host"], "properties": {"host": {"minLength": 1}}},
              "then": {"required": ["port"]}
            },
            "otlp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "endpoint": {"type": "string", "pattern": "^(https://(\\[[0-9a-fA-F:.]+\\]|[^\\s/@?#:\\[\\]]+)(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/[^\\s?#]*)?$"},
                "caSecret": {"type": "string"},
                "clientSecret": {"type": "string"},
                "headersSecret": {"type": "string"},
                "to": {"type": "array", "items": {
                  "type": "object", "minProperties": 1, "additionalProperties": false,
                  "properties": {
                    "ipBlock": {"type": "object"},
                    "namespaceSelector": {"type": "object"},
                    "podSelector": {"type": "object"}
                  }
                }}
              }
            }
          }
        }
      }
    },
    "auditRetention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "secret": {"type": "string"},
        "schedule": {"type": "string", "minLength": 9},
        "platformDays": {"anyOf": [{"type": "string", "maxLength": 0}, {"type": "integer", "minimum": 365, "maximum": 36500}]},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535, "not": {"const": 8080}},
        "scrapeFrom": {"type": "array", "items": {
          "type": "object", "minProperties": 1, "additionalProperties": false,
          "properties": {
            "ipBlock": {"type": "object"},
            "namespaceSelector": {"type": "object"},
            "podSelector": {"type": "object"}
          }
        }},
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "exportLagSeconds": {"type": "integer", "minimum": 60},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    }
  }
}
