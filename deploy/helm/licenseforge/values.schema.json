{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "issuer": {"type": "string"},
        "clientID": {"type": "string"},
        "redirectURL": {"type": "string"},
        "clientSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          },
          "if": {"required": ["secretName"], "properties": {"secretName": {"minLength": 1}}},
          "then": {"required": ["key"]}
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "to": {"type": "array", "items": {
              "type": "object", "minProperties": 1, "additionalProperties": false,
              "properties": {
                "ipBlock": {"type": "object"},
                "namespaceSelector": {"type": "object"},
                "podSelector": {"type": "object"}
              }
            }}
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "syslog": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host": {"type": "string", "pattern": "^[^\\s/]*$"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "serverName": {"type": "string"},
                "caSecret": {"type": "string"},
                "clientSecret": {"type": "string"},
                "sdID": {"type": "string"},
                "to": {"type": "array", "items": {
                  "type": "object", "minProperties": 1, "additionalProperties": false,
                  "properties": {
                    "ipBlock": {"type": "object"},
                    "namespaceSelector": {"type": "object"},
                    "podSelector": {"type": "object"}
                  }
                }}
              },
              "if": {"required": ["host"], "properties": {"host": {"minLength": 1}}},
              "then": {"required": ["port"]}
            },
            "otlp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "endpoint": {"type": "string", "pattern": "^(https://[^\\s/@?#]+/[^\\s?#]*)?$"},
                "caSecret": {"type": "string"},
                "clientSecret": {"type": "string"},
                "headersSecret": {"type": "string"},
                "to": {"type": "array", "items": {
                  "type": "object", "minProperties": 1, "additionalProperties": false,
                  "properties": {
                    "ipBlock": {"type": "object"},
                    "namespaceSelector": {"type": "object"},
                    "podSelector": {"type": "object"}
                  }
                }}
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535, "not": {"const": 8080}},
        "scrapeFrom": {"type": "array", "items": {
          "type": "object", "minProperties": 1, "additionalProperties": false,
          "properties": {
            "ipBlock": {"type": "object"},
            "namespaceSelector": {"type": "object"},
            "podSelector": {"type": "object"}
          }
        }},
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    }
  }
}
