# Test fixture for FIPS mode (pom.xml, fips execution), not a deployment config:
# BCFIPS first, the JDK's other providers kept (TLS stays on SunJSSE). README, "FIPS mode".
security.provider.1=org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider
security.provider.2=SUN
security.provider.3=SunEC
security.provider.4=SunJSSE
